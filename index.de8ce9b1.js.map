"use strict";
function waitFor(element, eventName) {
    return new Promise(function(resolve) {
        element.addEventListener(eventName, function() {
            var message = "It was ".concat(eventName, " on the element: ").concat(element.nodeName, ", id: ").concat(element.id, ".");
            resolve(message);
        }, {
            once: true
        });
    });
}
